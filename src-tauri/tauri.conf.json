{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bili-danmu",
  "version": "1.6.0",
  "identifier": "com.bilidanmu.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "bili-danmu",
        "width": 880,
        "height": 650,
        "minWidth": 520,
        "minHeight": 420,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://gh-proxy.org/https://github.com/bd-dxg/bili-danmu/releases/latest/download/latest.json",
        "https://cdn.gh-proxy.org/https://github.com/bd-dxg/bili-danmu/releases/latest/download/latest.json",
        "https://v4.gh-proxy.org/https://github.com/bd-dxg/bili-danmu/releases/latest/download/latest.json",
        "https://github.com/bd-dxg/bili-danmu/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5MTc2NUUwQkVCN0JDRDMKUldUVHZMZSs0R1VYeWVoTXJFQ3hGVGFGTGV3VHI4L3VKdERsUXBVZmlQR0M5SHhtVmQyQk9XbHMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
